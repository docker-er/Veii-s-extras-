<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Jellyfin.Plugin.Popups</RootNamespace>
    <AssemblyName>Jellyfin.Plugin.Popups</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
    <FileVersion>1.1.0.0</FileVersion>
    <Version>1.1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pinned to 12.0.0 so one DLL loads on every 12.x server (a newer host satisfies a lower reference). -->
    <PackageReference Include="Jellyfin.Controller" Version="12.0.0">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Jellyfin.Model" Version="12.0.0">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Configuration\configPage.html" LogicalName="Jellyfin.Plugin.Popups.Configuration.configPage.html" />
    <EmbeddedResource Include="Configuration\asksPage.html" LogicalName="Jellyfin.Plugin.Popups.Configuration.asksPage.html" />
    <EmbeddedResource Include="Web\popups.js" LogicalName="Jellyfin.Plugin.Popups.Web.popups.js" />
    <EmbeddedResource Include="Web\popups.css" LogicalName="Jellyfin.Plugin.Popups.Web.popups.css" />
    <EmbeddedResource Include="Web\asks.js" LogicalName="Jellyfin.Plugin.Popups.Web.asks.js" />
    <EmbeddedResource Include="Web\asks.css" LogicalName="Jellyfin.Plugin.Popups.Web.asks.css" />
  </ItemGroup>

</Project>
